@{ ViewData["Title"] = "Thống kê sản phẩm bán chạy"; }
@section Styles { <link rel="stylesheet" href="~/css/revenue.css" asp-append-version="true" /> }
<div class="revenue-page">
    <nav class="revenue-breadcrumb" aria-label="Đường dẫn"><a asp-action="Index">DOANH THU</a> / Thống kê sản phẩm bán chạy</nav>
    <h1>Thống kê sản phẩm bán chạy</h1>
    <section class="revenue-criteria-panel">
        <h2>Chọn tiêu chí thống kê</h2>
        <a class="revenue-button" asp-action="BanChay" asp-route-tieuChi="ca2"><i class="bi bi-layout-sidebar" aria-hidden="true"></i><span>Cả 2 tiêu chí</span></a>
        <a class="revenue-button" asp-action="BanChay" asp-route-tieuChi="doanhthu"><i class="bi bi-cash" aria-hidden="true"></i><span>Doanh thu</span></a>
        <a class="revenue-button" asp-action="BanChay" asp-route-tieuChi="soluong"><i class="bi bi-boxes" aria-hidden="true"></i><span>Số lượng bán ra</span></a>
    </section>
</div>
