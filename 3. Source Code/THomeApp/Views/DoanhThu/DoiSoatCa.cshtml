@model List<THomeApp.Models.KiemKeTienMat>
@{
    ViewData["Title"] = "Đối Soát Tiền Mặt Ca Trực";
    decimal tienMatPhanMem = ViewBag.TienMatPhanMem ?? 0m;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <a href="/DoanhThu/Index" class="btn btn-outline-secondary btn-sm mb-2">
            <i class="fa-solid fa-arrow-left me-1"></i> Quay lại doanh thu
        </a>
        <h4 class="fw-bold text-dark mb-0">
            <i class="fa-solid fa-scale-unbalanced-flip text-warning me-2"></i> Đối soát & Kiểm kê quỹ tiền mặt
        </h4>
    </div>
</div>

<div class="row g-4">
    <!-- FORM NHẬP KIỂM KÊ -->
    <div class="col-12 col-lg-5">
        <div class="card-thome">
            <div class="card-thome-header">
                <h5 class="card-thome-title">
                    <i class="fa-solid fa-calculator text-primary"></i> Nhập số liệu kiểm đếm thực tế
                </h5>
            </div>
            <div class="card-thome-body p-4">
                <form method="post" action="/DoanhThu/LuuDoiSoatCa">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Ca làm việc / Đợt kiểm đếm:</label>
                        <select name="caLamViec" class="form-select" onchange="location.href='/DoanhThu/DoiSoatCa?caLamViec='+encodeURIComponent(this.value)">
                            <option value="Ca sáng (07:30 - 12:00)" selected="@(ViewBag.CaLamViec == "Ca sáng (07:30 - 12:00)")">Ca sáng (07:30 - 12:00)</option>
                            <option value="Ca chiều (13:30 - 17:30)" selected="@(ViewBag.CaLamViec == "Ca chiều (13:30 - 17:30)")">Ca chiều (13:30 - 17:30)</option>
                            <option value="Cuối ngày (Tổng kết)" selected="@(ViewBag.CaLamViec == "Cuối ngày (Tổng kết)")">Cuối ngày (Tổng kết đóng quầy)</option>
                        </select>
                    </div>

                    <!-- Tiền mặt phần mềm ghi nhận -->
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Tiền mặt phần mềm ghi nhận trong ngày:</label>
                        <div class="input-group">
                            <input type="text" class="form-control bg-light fw-bold text-primary" readonly
                                   value="@string.Format("{0:N0} đ", tienMatPhanMem)" />
                            <input type="hidden" name="tienMatPhanMem" id="softCash" value="@tienMatPhanMem" />
                            <span class="input-group-text bg-light"><i class="fa-solid fa-laptop"></i></span>
                        </div>
                        <small class="text-muted" style="font-size: 11px;">Đã cộng tiền mặt đã thu và trừ các khoản chi thực tế</small>
                    </div>

                    <!-- Tiền mặt nhân viên thực tế kiểm đếm -->
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark">Tiền mặt thực tế kiểm đếm (VNĐ) <span class="text-danger">*</span></label>
                        <input type="number" id="actualCash" name="tienMatKiemDem" class="form-control fw-bold fs-5 text-success"
                               value="@tienMatPhanMem" min="0" step="1000" required oninput="calcDifference()" />
                    </div>

                    <!-- Live Difference Indicator -->
                    <div class="card bg-light border p-3 mb-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold small text-muted">Chênh lệch đối soát:</span>
                            <span class="fw-bold fs-5 text-success" id="diffDisplay">0 đ (Khớp 100%)</span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Ghi chú / Giải trình (nếu có chênh lệch):</label>
                        <textarea name="ghiChu" class="form-control" rows="2" placeholder="Ví dụ: Đã trả tiền lẻ thối lại, hoặc chi thêm nước uống..."></textarea>
                    </div>

                    <button type="submit" class="btn btn-thome-primary w-100 py-2 fw-bold">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Lưu kết quả đối soát ca
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- BẢNG LỊCH SỬ ĐỐI SOÁT -->
    <div class="col-12 col-lg-7">
        <div class="card-thome">
            <div class="card-thome-header">
                <h5 class="card-thome-title">
                    <i class="fa-solid fa-clock-rotate-left text-primary"></i> Lịch sử kiểm kê quỹ tiền mặt gần đây
                </h5>
            </div>
            <div class="card-thome-body p-0">
                @if (!Model.Any())
                {
                    <div class="text-center py-5 text-muted small">
                        Chưa có lượt kiểm đếm nào được ghi nhận.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th class="ps-3">Thời gian</th>
                                    <th>Ca trực</th>
                                    <th>Nhân viên</th>
                                    <th class="text-end">Phần mềm</th>
                                    <th class="text-end">Kiểm đếm</th>
                                    <th class="text-end pe-3">Chênh lệch</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var k in Model)
                                {
                                    var diff = k.TienMatKiemDem - k.TienMatPhanMem;
                                    <tr>
                                        <td class="ps-3 small">@k.NgayTao.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>
                                            <span class="badge bg-light text-dark border">@k.CaLamViec</span>
                                        </td>
                                        <td class="small fw-semibold">@(k.NhanVien?.HoTen ?? k.MaNV)</td>
                                        <td class="text-end small">@string.Format("{0:N0} đ", k.TienMatPhanMem)</td>
                                        <td class="text-end fw-bold text-dark">@string.Format("{0:N0} đ", k.TienMatKiemDem)</td>
                                        <td class="text-end pe-3 fw-bold @(diff == 0 ? "text-success" : (diff > 0 ? "text-primary" : "text-danger"))">
                                            @if (diff == 0)
                                            {
                                                <span>0 đ <i class="fa-solid fa-circle-check"></i></span>
                                            }
                                            else if (diff > 0)
                                            {
                                                <span>+@string.Format("{0:N0} đ", diff)</span>
                                            }
                                            else
                                            {
                                                <span>@string.Format("{0:N0} đ", diff)</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function calcDifference() {
        const soft = parseFloat(document.getElementById('softCash').value) || 0;
        const actual = parseFloat(document.getElementById('actualCash').value) || 0;
        const diff = actual - soft;
        const disp = document.getElementById('diffDisplay');

        if (diff === 0) {
            disp.innerText = "0 đ (Khớp 100%)";
            disp.className = "fw-bold fs-5 text-success";
        } else if (diff > 0) {
            disp.innerText = "+" + diff.toLocaleString('vi-VN') + " đ (Thừa quỹ)";
            disp.className = "fw-bold fs-5 text-primary";
        } else {
            disp.innerText = diff.toLocaleString('vi-VN') + " đ (Thiếu quỹ)";
            disp.className = "fw-bold fs-5 text-danger";
        }
    }
</script>
}
