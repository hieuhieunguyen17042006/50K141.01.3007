@model THomeApp.Models.HoaDon
@{
    ViewData["Title"] = "Thao tác đã bị chặn!";
}

<div class="row justify-content-center py-4">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card-thome shadow border-danger">
            <div class="card-header bg-danger text-white py-3 text-center">
                <i class="fa-solid fa-lock fs-1 mb-2"></i>
                <h4 class="fw-bold mb-0">THAO TÁC ĐÃ BỊ CHẶN DO VƯỢT QUÁ GIỚI HẠN!</h4>
            </div>
            <div class="card-thome-body p-4">
                <div class="alert alert-danger mb-4">
                    <p class="mb-1">Hóa đơn <strong>@Model.MaHD</strong> đã thực hiện ghi đè <strong>@Model.SoLanGhiDe lần</strong>.</p>
                    <p class="mb-0 small">Theo quy định nghiệp vụ <strong>BR-UC2.6-01</strong>, hệ thống tự động khóa hoàn toàn quyền ghi đè đối với hóa đơn này để đảm bảo an toàn doanh thu.</p>
                </div>

                <div class="mb-4">
                    <h6 class="fw-bold text-dark mb-2">Quy trình cấp quyền mở khóa:</h6>
                    <p class="small text-muted mb-0">Kế toán viên cần gửi lý do giải trình cụ thể. Yêu cầu sẽ được chuyển đến <strong>Chủ cửa hàng</strong> để phê duyệt và cấp lại quyền.</p>
                </div>

                <form method="post" action="/BanHang/GuiYeuCauMoKhoa">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="maHD" value="@Model.MaHD" />

                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark">Lý do xin mở khóa quyền <span class="text-danger">*</span> (BR-UC2.6-05):</label>
                        <textarea name="lyDoMoKhoa" class="form-control" rows="4" required placeholder="Nhập lý do chi tiết để Chủ cửa hàng xem xét phê duyệt mở khóa..."></textarea>
                    </div>

                    <div class="d-flex justify-content-between gap-3 mt-4">
                        <a href="/BanHang/ChiTietHoaDon?id=@Model.MaHD" class="btn btn-outline-secondary px-4">
                            <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
                        </a>
                        <button type="submit" class="btn btn-danger px-4 fw-bold">
                            <i class="fa-solid fa-paper-plane me-1"></i> Gửi yêu cầu mở khóa
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
