@model string
@{
    ViewData["Title"] = "Không tìm thấy hóa đơn";
}

<div class="row justify-content-center py-5">
    <div class="col-12 col-md-6 text-center">
        <div class="card-thome p-5 shadow-sm">
            <div class="text-muted mb-3">
                <i class="fa-solid fa-magnifying-glass-chart" style="font-size: 64px; color: #94a3b8;"></i>
            </div>
            <h4 class="fw-bold text-dark mb-2">Không tìm thấy hóa đơn phù hợp!</h4>
            <p class="text-muted mb-4">Hệ thống không tìm thấy hóa đơn hoặc đơn tạm tính nào có mã <strong>"@Model"</strong>.</p>
            <div class="d-flex justify-content-center gap-3">
                <a href="/BanHang/Index?tab=hoadon" class="btn btn-thome-primary px-4 fw-bold">
                    <i class="fa-solid fa-list me-1"></i> Quay lại danh sách
                </a>
                <a href="/BanHang/TaoDonTamTinh" class="btn btn-outline-primary px-4">
                    <i class="fa-solid fa-plus me-1"></i> Tạo đơn mới
                </a>
            </div>
        </div>
    </div>
</div>
