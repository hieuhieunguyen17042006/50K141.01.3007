@{ Layout = null; }
<!DOCTYPE html><html lang="vi"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Đăng nhập - T-HOME</title>
<link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
<style>
body{margin:0;background:#083e70;font-family:"Segoe UI",sans-serif;min-height:100vh;display:grid;place-items:center;color:#083e70}
.login-scene{position:relative;width:min(100vw,calc(100vh * 1.40625));aspect-ratio:1440/1024}
.scene{width:100%;height:100%;position:absolute;inset:0}
.login-field{position:absolute;left:8.54%;width:36.8%;height:6.93%;border:1px solid #bbcbd6;border-radius:15px;background:#fff;padding:0 2.1%;font-weight:650;font-size:clamp(14px,1.9vw,28px);color:#083e70;box-shadow:2px 3px 3px #0005}
.login-field::placeholder{color:#083e70;opacity:1}
#tenDN{top:51.86%}#matKhau{top:63.38%}
.login-submit{position:absolute;top:74.9%;left:13.4%;width:27.15%;height:5.3%;border:0;border-radius:35px;background:#92d2ff;color:#083e70;font-size:clamp(14px,1.9vw,28px);font-weight:750;box-shadow:2px 4px 4px #0004}
.login-error{position:absolute;left:8.54%;width:36.8%;top:70.9%;font-weight:650;background:#fff0f0;color:#a01c27;border-radius:8px;padding:6px 12px;font-size:clamp(11px,1vw,16px)}
.demo{position:absolute;top:83%;left:8.54%;width:36.8%;color:white;font-size:clamp(10px,.9vw,13px)}.demo button{background:transparent;border:1px solid #a6d9ff;color:white;border-radius:5px;margin:4px 2px;padding:3px 7px}
@@media(max-width:650px){.login-scene{width:100%;min-height:640px;aspect-ratio:auto;background:#1c61e7;border-radius:20px}.scene{object-fit:cover;object-position:left top;opacity:.15}#tenDN{top:34%}#matKhau{top:48%}.login-field{left:8%;width:84%;height:60px;font-size:21px;padding:15px}.login-submit{top:65%;left:20%;width:60%;height:55px;font-size:22px}.login-error{top:59%;left:8%;width:84%;font-size:13px}.demo{top:78%;left:8%;width:84%;font-size:14px}}
</style></head><body><main class="login-scene">
<img class="scene" src="/images/login-scene.png" alt="Công ty TNHH Thương mại T-HOME" />
<form method="post" asp-action="Login" id="loginForm">
@Html.AntiForgeryToken()<input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
<label class="visually-hidden" for="tenDN">Tên đăng nhập</label><input class="login-field" id="tenDN" name="tenDN" type="text" autocomplete="username" placeholder="Tên đăng nhập" maxlength="10" required autofocus />
<label class="visually-hidden" for="matKhau">Mật khẩu</label><input class="login-field" id="matKhau" name="matKhau" type="password" autocomplete="current-password" placeholder="Mật khẩu" required />
@if(ViewBag.ErrorMessage != null){<div class="login-error" role="alert">@ViewBag.ErrorMessage</div>}
<button class="login-submit" type="submit">Đăng nhập</button>
</form>
<details class="demo"><summary>Tài khoản demo</summary><button type="button" onclick="fillAccount('admin')">Chủ cửa hàng</button><button type="button" onclick="fillAccount('ketoan')">Kế toán</button><button type="button" onclick="fillAccount('nhanvien')">Nhân viên</button><div>Chọn vai trò và nhập mật khẩu được cấp riêng.</div></details>
</main><script>function fillAccount(user){document.getElementById('tenDN').value=user;document.getElementById('matKhau').value='';document.getElementById('matKhau').focus()}</script></body></html>
