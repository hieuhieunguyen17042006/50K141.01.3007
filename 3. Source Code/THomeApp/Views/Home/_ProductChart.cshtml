@using System.Globalization
@model ProductRanking
@{
    var quantity=Model.Key=="quantity";
    var peak=Model.Rows.Select(r=>quantity?(decimal)r.Quantity:r.Revenue).DefaultIfEmpty(0).Max();
    var step=quantity?Math.Max(1,Math.Ceiling(peak/4)):Math.Max(1,Math.Ceiling(peak/4/1000000))*1000000;
    var max=step*4; var height=Math.Max(244,Model.Rows.Count*34+42);
    string N(decimal n)=>n.ToString("0.###",CultureInfo.InvariantCulture);
}
<div class="dashboard-product-chart" data-product-chart="@Model.Key">
@if(Model.Rows.Count==0){<div class="dashboard-no-data">Không có dữ liệu!</div>}else{
<svg class="dashboard-horizontal-bars" viewBox="0 0 560 @height" role="img" aria-label="@Model.Title">
    @for(var tick=0;tick<=4;tick++){var x=130+tick*95;<g><line x1="@x" x2="@x" y1="8" y2="@(height-32)" stroke="#d5deeb" stroke-dasharray="2 3"/><text x="@x" y="@(height-10)" text-anchor="middle">@((step*tick/(quantity?1:1000000)).ToString("0.#",CultureInfo.GetCultureInfo("vi-VN")))@(quantity?"":"tr")</text></g>}
    @for(var i=0;i<Model.Rows.Count;i++){var row=Model.Rows[i];var value=quantity?(decimal)row.Quantity:row.Revenue;var width=value/max*380;var y=16+i*34;
        <g data-product="@row.Code" data-value="@N(value)" data-start="0"><text x="120" y="@(y+11)" text-anchor="end"><title>@row.Name</title>@(row.Name.Length>19?row.Name[..18]+"…":row.Name)</text><rect x="130" y="@y" width="@N(width)" height="16" rx="4" fill="#776bea"><title>@row.Name: @value.ToString("N0",CultureInfo.GetCultureInfo("vi-VN")) @(quantity?"":"đ")</title></rect><text x="@N(136+width)" y="@(y+12)">@value.ToString("N0",CultureInfo.GetCultureInfo("vi-VN"))</text></g>
    }
</svg>
}
</div>
