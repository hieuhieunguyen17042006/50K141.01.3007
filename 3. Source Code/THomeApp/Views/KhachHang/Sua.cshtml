@model THomeApp.Models.KhachHang
@{
    ViewData["Title"] = $"Chỉnh sửa thông tin: {Model.HoTen}";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card-thome shadow-sm">
            <div class="card-thome-header d-flex justify-content-between align-items-center">
                <h5 class="card-thome-title">
                    <i class="fa-solid fa-user-pen text-primary"></i> Sửa thông tin khách hàng - @Model.MaKH
                </h5>
                <span class="badge bg-warning text-dark">Chỉ sửa SĐT, Địa chỉ, Email, Ghi chú (BR-UC3.2-02)</span>
            </div>
            <div class="card-thome-body p-4">
                <form method="post" asp-action="Sua">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="maKH" value="@Model.MaKH" />

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger" asp-validation-summary="All"></div>
                    }

                    <div class="row g-3">
                        <!-- Trường chỉ đọc theo BR-UC3.2-02 -->
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Mã khách hàng:</label>
                            <input type="text" class="form-control bg-light" readonly value="@Model.MaKH" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Loại khách hàng:</label>
                            <input type="text" class="form-control bg-light" readonly value="@Model.LoaiKhach" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Họ và tên (Cố định):</label>
                            <input type="text" class="form-control bg-light" readonly value="@Model.HoTen" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Tổng tích lũy mua hàng:</label>
                            <input type="text" class="form-control bg-light fw-bold text-primary" readonly value="@string.Format("{0:N0} đ", Model.TongTichLuy)" />
                        </div>

                        @if (Model.LoaiKhach == "Doanh nghiệp")
                        {
                            <div class="col-md-7">
                                <label class="form-label small fw-bold text-muted">Tên công ty (Cố định):</label>
                                <input type="text" class="form-control bg-light" readonly value="@Model.TenCongTy" />
                            </div>
                            <div class="col-md-5">
                                <label class="form-label small fw-bold text-muted">Mã số thuế (Cố định):</label>
                                <input type="text" class="form-control bg-light" readonly value="@Model.MaSoThue" />
                            </div>
                        }

                        <hr class="my-3" />
                        <h6 class="fw-bold text-primary mb-1"><i class="fa-solid fa-pen me-1"></i> Các trường được phép chỉnh sửa:</h6>

                        <!-- SĐT: được sửa nhưng phải chuẩn 10 số bắt đầu bằng 0, không trùng khách khác (BR-UC3.2-01) -->
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Số điện thoại <span class="text-danger">*</span></label>
                            <input type="text" name="sdt" class="form-control" value="@Model.SDT" required maxlength="10" />
                            <small class="text-muted" style="font-size: 11px;">10 chữ số, bắt đầu bằng số 0 (BR-UC3.2-01)</small>
                        </div>

                        <!-- Email: được sửa -->
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Email</label>
                            <input type="email" name="email" class="form-control" value="@Model.Email" />
                        </div>

                        <!-- Địa chỉ: được sửa -->
                        <div class="col-12">
                            <label class="form-label small fw-bold">Địa chỉ liên hệ</label>
                            <input type="text" name="diaChi" class="form-control" value="@Model.DiaChi" />
                        </div>

                        <!-- Ghi chú: được sửa -->
                        <div class="col-12">
                            <label class="form-label small fw-bold">Ghi chú</label>
                            <textarea name="ghiChu" class="form-control" rows="2">@Model.GhiChu</textarea>
                        </div>

                        <!-- Lý do chỉnh sửa để ghi nhật ký BR-UC3.2-03 -->
                        <div class="col-12">
                            <label class="form-label small fw-bold text-dark">Lý do thay đổi thông tin <span class="text-danger">*</span> (BR-UC3.2-03)</label>
                            <input type="text" name="lyDo" class="form-control" required placeholder="Ví dụ: Khách hàng đổi số điện thoại liên hệ mới..." />
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-3 mt-4 pt-3 border-top">
                        <a href="/KhachHang/ChiTiet?id=@Model.MaKH" class="btn btn-outline-secondary px-4">Hủy</a>
                        <button type="submit" class="btn btn-thome-primary px-4 fw-bold">
                            <i class="fa-solid fa-floppy-disk me-1"></i> Cập nhật thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
