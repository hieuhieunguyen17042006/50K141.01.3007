@using System.Text.RegularExpressions
@using System.Globalization
@inject THomeApp.Services.ActivityLogTime ActivityTime
@model List<LichSuHoatDong>
@{ViewData["Title"]="Lịch sử hoạt động";var vi=CultureInfo.GetCultureInfo("vi-VN");}
@section Styles {<link rel="stylesheet" href="~/css/catalog.css" asp-append-version="true" />}
<div class="catalog-page store-page">
    <h1 class="catalog-breadcrumb prominent">CỬA HÀNG <span>/ Lịch sử hoạt động</span></h1>
    <section class="catalog-panel tall"><header class="catalog-panel-heading activity-panel-heading"><h2>Danh sách lịch sử hoạt động</h2><form class="catalog-search activity-filters" method="get">
        <input type="hidden" name="doiTuong" value="@ViewBag.DoiTuong" />
        <label>Từ khóa<input class="form-control" type="search" name="search" value="@ViewBag.Search" placeholder="Nhập từ khóa tìm kiếm" aria-label="Tìm lịch sử" /></label>
        <label>Từ ngày<input class="form-control" type="date" name="fromDate" value="@ViewBag.FromDate" /></label>
        <label>Đến ngày<input class="form-control" type="date" name="toDate" value="@ViewBag.ToDate" /></label>
        <button class="catalog-white" type="submit">Tìm</button></form></header>
        <p class="activity-timezone">Thời gian Việt Nam (UTC+7)</p>
        @if(ViewBag.DateFilterError is string dateError){<p class="activity-filter-error" role="alert"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> @dateError</p>}
        <div class="catalog-table-wrap table-responsive"><table class="catalog-table" id="activityTable"><thead><tr><th>Thời gian thực hiện</th><th>Người thực hiện</th><th>Nội dung thao tác</th><th>Lý do</th></tr></thead><tbody>
        @foreach(var entry in Model){
            var vietnamTime=ActivityTime.ToVietnam(entry.ThoiGianThaoTac);
            var count=Regex.Match(entry.NoiDungThaoTac,@"lần\s+(?:thứ\s+)?(\d+)",RegexOptions.IgnoreCase);
            var number=entry.LoaiDoiTuong=="HoaDon"&&entry.NoiDungThaoTac.StartsWith("Ghi đè",StringComparison.OrdinalIgnoreCase)&&count.Success&&int.TryParse(count.Groups[1].Value,out var parsed)?parsed:0;
            <tr data-log-id="@entry.MaLichSu"><td><time datetime="@vietnamTime.ToString("o")" data-activity-time>@vietnamTime.ToString("dd/MM/yyyy",vi)<br />@vietnamTime.ToString("HH:mm",vi)</time></td><td>@(entry.NhanVien?.HoTen??entry.MaNV)<small class="d-block">@(entry.NhanVien?.ViTri=="Chủ cửa hàng"?"Chủ cửa hàng":"Nhân viên")</small></td><td>@entry.NoiDungThaoTac
            @if(entry.DuLieuThayDoiJson!=null){<details class="activity-changes"><summary>Chi tiết thay đổi</summary><p class="activity-log-time">Thời gian thực hiện: <time datetime="@vietnamTime.ToString("o")">@vietnamTime.ToString("dd/MM/yyyy HH:mm:ss",vi)</time> (UTC+7)</p><pre>@entry.DuLieuThayDoiJson</pre></details>}
            @if(number>=2&&number<=6){<span class="catalog-status @(number>=5?"rejected":"pending")">@(number>=5?"Cảnh báo nặng":"Cảnh báo nhẹ")</span>}
            </td><td>@(entry.LyDo??"—")</td></tr>
        }
        @if(Model.Count==0){<tr><td colspan="4" class="catalog-empty">Không tìm thấy lịch sử phù hợp!</td></tr>}
        </tbody></table></div>
    </section>
</div>
@section Scripts {<script src="~/js/catalog.js" asp-append-version="true"></script>}
