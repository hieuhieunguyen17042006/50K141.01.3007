@using System.Globalization
@model List<ChietKhau>
@{ViewData["Title"]="Ưu đãi chiết khấu";}
@section Styles {<link rel="stylesheet" href="~/css/catalog.css" asp-append-version="true" />}
<div class="catalog-page store-page">
    <h1 class="catalog-breadcrumb prominent">CỬA HÀNG <span>/ Ưu đãi chiết khấu</span></h1>
    <section class="catalog-panel tall"><header class="catalog-panel-heading"><h2>Danh sách ưu đãi chiết khấu</h2><button class="catalog-primary" type="button" id="newDiscountButton">+ Thêm</button></header>
        <div class="catalog-table-wrap table-responsive"><table class="catalog-table" id="discountsTable"><thead><tr><th>STT</th><th>Mốc mua hàng tích lũy (VNĐ)</th><th>Tỷ lệ chiết khấu (%)</th><th>Thao tác</th></tr></thead><tbody>
        @for(var i=0;i<Model.Count;i++){var discount=Model[i];<tr data-discount-id="@discount.MaCK"><td>@(i+1)</td><td>@discount.MocTichLuy.ToString("N0",CultureInfo.GetCultureInfo("vi-VN"))</td><td>@discount.TyLeChietKhau.ToString("0.##",CultureInfo.GetCultureInfo("vi-VN"))%</td><td><div class="catalog-row-actions"><button class="catalog-edit" type="button" data-discount-edit="@discount.MaCK" data-threshold="@discount.MocTichLuy.ToString(CultureInfo.InvariantCulture)" data-rate="@discount.TyLeChietKhau.ToString(CultureInfo.InvariantCulture)">Sửa</button><button class="catalog-delete" type="button" data-discount-delete="@discount.MaCK">Xóa</button></div></td></tr>}
        @if(Model.Count==0){<tr><td colspan="4" class="catalog-empty">Không có mức chiết khấu đang áp dụng.</td></tr>}
        </tbody></table></div>
    </section>
</div>
<div class="modal fade catalog-modal" id="discountModal" tabindex="-1" aria-labelledby="discountTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
    <header class="catalog-modal-header"><h2 id="discountTitle">Thêm ưu đãi chiết khấu mới</h2></header>
    <form class="catalog-form" method="post" asp-action="ThemChietKhau" novalidate><input type="hidden" name="MaCK" value="0" /><div class="catalog-form-error" role="alert" hidden></div>
        <div class="catalog-fields"><label>Mốc giá trị mua hàng tích lũy <em>*</em><input class="form-control" type="number" name="MocTichLuy" min="0" step="1" required /><span data-error-for="MocTichLuy"></span></label><label>Tỷ lệ chiết khấu <em>*</em><input class="form-control" type="number" name="TyLeChietKhau" min="0" max="100" step="0.01" required /><span data-error-for="TyLeChietKhau"></span></label>
        <label id="discountReason" hidden>Lý do sửa <em>*</em><textarea class="form-control" name="LyDo" maxlength="500" disabled></textarea><span data-error-for="LyDo"></span></label></div>
        <footer class="catalog-modal-actions"><button class="catalog-white" type="button" data-bs-dismiss="modal">Hủy</button><button class="catalog-primary" type="submit">Lưu</button></footer>
    </form>
</div></div></div>
<div class="modal fade catalog-modal" id="discountDeleteModal" tabindex="-1" aria-labelledby="discountDeleteTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
    <header class="catalog-modal-header"><h2 id="discountDeleteTitle">Xóa mức chiết khấu</h2></header>
    <form class="catalog-form" method="post" asp-action="XoaChietKhau" novalidate><input type="hidden" name="maCK" /><div class="catalog-form-error" role="alert" hidden></div><p>Bạn chắc chắn muốn xóa mức chiết khấu này?</p>
        <label>Lý do xóa <em>*</em><textarea name="lyDo" class="form-control" maxlength="500" required></textarea><span data-error-for="LyDo"></span></label>
        <footer class="catalog-modal-actions"><button class="catalog-white" type="button" data-bs-dismiss="modal">Hủy</button><button class="catalog-primary" type="submit">Xác nhận</button></footer>
    </form>
</div></div></div>
<partial name="_CatalogResult" />
@section Scripts {<script src="~/js/catalog.js" asp-append-version="true"></script>}
