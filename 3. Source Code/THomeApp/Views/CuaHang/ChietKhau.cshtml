@using System.Globalization
@model List<ChietKhau>
@{
    ViewData["Title"]="Ưu đãi chiết khấu";
    var discounts=Model.OrderBy(c=>c.MocTichLuy).ThenBy(c=>c.MaCK).ToList();
    var conflicts=discounts.Zip(discounts.Skip(1),(lower,upper)=>new {lower,upper})
        .Where(p=>p.lower.MocTichLuy==p.upper.MocTichLuy||p.upper.TyLeChietKhau<=p.lower.TyLeChietKhau).ToList();
    var conflictIds=conflicts.SelectMany(p=>new[]{p.lower.MaCK,p.upper.MaCK}).ToHashSet();
    string Money(decimal n)=>n.ToString("N0",CultureInfo.GetCultureInfo("vi-VN"));
}
@section Styles {<link rel="stylesheet" href="~/css/catalog.css" asp-append-version="true" />}
<div class="catalog-page store-page">
    <h1 class="catalog-breadcrumb prominent">CỬA HÀNG <span>/ Ưu đãi chiết khấu</span></h1>
    <section class="catalog-panel tall"><header class="catalog-panel-heading"><h2>Danh sách ưu đãi chiết khấu</h2><button class="catalog-primary" type="button" id="newDiscountButton">+ Thêm</button></header>
        @if(conflicts.Count>0){
            <div class="alert alert-warning" role="alert" data-discount-conflicts>
                <strong>Chính sách đang có mức xung đột, cần rà soát:</strong>
                <ul class="mb-2">@foreach(var pair in conflicts){<li>#@pair.lower.MaCK: @Money(pair.lower.MocTichLuy) VNĐ → @pair.lower.TyLeChietKhau.ToString("0.##",CultureInfo.GetCultureInfo("vi-VN"))% và #@pair.upper.MaCK: @Money(pair.upper.MocTichLuy) VNĐ → @pair.upper.TyLeChietKhau.ToString("0.##",CultureInfo.GetCultureInfo("vi-VN"))%.</li>}</ul>
                Mốc không được trùng; tỷ lệ phải tăng theo mốc tích lũy. Chưa tự thay tỷ lệ của các bản ghi này.
            </div>
        }
        <div class="catalog-table-wrap table-responsive"><table class="catalog-table" id="discountsTable"><thead><tr><th>STT</th><th>Mốc mua hàng tích lũy (VNĐ)</th><th>Tỷ lệ chiết khấu (%)</th><th>Thao tác</th></tr></thead><tbody>
        @for(var i=0;i<discounts.Count;i++){var discount=discounts[i];<tr data-discount-id="@discount.MaCK" class="@(conflictIds.Contains(discount.MaCK)?"table-warning":null)"><td>@(i+1)</td><td>@discount.MocTichLuy.ToString("N0",CultureInfo.GetCultureInfo("vi-VN"))</td><td>@discount.TyLeChietKhau.ToString("0.##",CultureInfo.GetCultureInfo("vi-VN"))%</td><td><div class="catalog-row-actions"><button class="catalog-edit" type="button" data-discount-edit="@discount.MaCK" data-threshold="@discount.MocTichLuy.ToString(CultureInfo.InvariantCulture)" data-rate="@discount.TyLeChietKhau.ToString(CultureInfo.InvariantCulture)">Sửa</button><button class="catalog-delete" type="button" data-discount-delete="@discount.MaCK" data-threshold="@discount.MocTichLuy.ToString(CultureInfo.InvariantCulture)" data-rate="@discount.TyLeChietKhau.ToString(CultureInfo.InvariantCulture)">Xóa</button></div></td></tr>}
        @if(Model.Count==0){<tr><td colspan="4" class="catalog-empty">Không có mức chiết khấu đang áp dụng.</td></tr>}
        </tbody></table></div>
    </section>
</div>
<div class="modal fade catalog-modal" id="discountModal" tabindex="-1" aria-labelledby="discountTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
    <header class="catalog-modal-header"><h2 id="discountTitle">Thêm ưu đãi chiết khấu mới</h2></header>
    <form class="catalog-form" method="post" asp-action="ThemChietKhau" data-discount-form novalidate><input type="hidden" name="MaCK" value="0" />
        <div class="catalog-fields"><label>Mốc giá trị mua hàng tích lũy <em>*</em><div class="discount-input-unit"><input class="form-control" type="number" name="MocTichLuy" min="0" max="1000000000000" step="1" required /><span>VNĐ</span></div></label><label>Tỷ lệ chiết khấu <em>*</em><div class="discount-input-unit"><input class="form-control" type="number" name="TyLeChietKhau" min="0" max="100" step="0.01" required /><span>%</span></div></label></div>
        <partial name="_FormError" /><footer class="catalog-modal-actions"><button class="catalog-white" type="button" data-bs-dismiss="modal">Hủy</button><button class="catalog-primary" type="submit">Lưu</button></footer>
    </form>
</div></div></div>
<div class="modal fade catalog-modal" id="discountDeleteModal" tabindex="-1" aria-labelledby="discountDeleteTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
    <header class="catalog-modal-header"><h2 id="discountDeleteTitle">Xác nhận xóa mức chiết khấu</h2></header>
    <form class="catalog-form" method="post" asp-action="XoaChietKhau" novalidate><input type="hidden" name="maCK" /><div class="catalog-form-error" role="alert" hidden></div><p class="discount-delete-warning"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i><span>Bạn có chắc chắn muốn xóa mức chiết khấu này không?</span></p>
        <label>Mốc giá trị mua hàng tích lũy<div class="discount-readonly"><input class="form-control" id="deleteDiscountThreshold" readonly /><span>VNĐ</span></div></label>
<label class="mt-3">Tỷ lệ chiết khấu<div class="discount-readonly"><input class="form-control" id="deleteDiscountRate" readonly /><span>%</span></div></label>
        <footer class="catalog-modal-actions"><button class="catalog-white" type="button" data-bs-dismiss="modal">Hủy</button><button class="catalog-primary" type="submit">Đồng ý</button></footer>
    </form>
</div></div></div>
<partial name="_CatalogResult" />
@section Scripts {<script src="~/js/catalog.js" asp-append-version="true"></script>}
