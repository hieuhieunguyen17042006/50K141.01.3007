@using System.Text.Json
@model List<YeuCauMoKhoa>
@{ViewData["Title"]="Yêu cầu mở khóa";}
@section Styles {<link rel="stylesheet" href="~/css/catalog.css" asp-append-version="true" />}
<div class="catalog-page store-page">
    <h1 class="catalog-breadcrumb prominent">CỬA HÀNG <span>/ Yêu cầu mở khóa</span></h1>
    <section class="catalog-panel tall"><header class="catalog-panel-heading"><h2>Danh sách yêu cầu mở khóa</h2></header>
    <div class="catalog-table-wrap table-responsive"><table class="catalog-table" id="unlockRequestsTable"><thead><tr><th>Mã hóa đơn</th><th>Người yêu cầu</th><th>Số lần ghi đè</th><th>Trạng thái</th></tr></thead><tbody>
    @foreach(var request in Model){
        var data=new {id=request.MaYC,invoice=request.HoaDon?.MaHoaDon??request.MaHD,name=request.NhanVien?.HoTen??request.MaNV,role=request.NhanVien?.ViTri,count=request.HoaDon?.SoLanGhiDe??0,time=request.ThoiGianGui.ToString("dd/MM/yyyy • HH:mm"),reason=request.LyDoMoKhoa,status=request.TrangThai,note=request.GhiChuDuyet};
        <tr tabindex="0" data-unlock-request="@JsonSerializer.Serialize(data)" data-request-id="@request.MaYC"><td>@data.invoice</td><td>@data.name</td><td>@data.count</td><td><span class="catalog-status @(request.TrangThai=="Chờ duyệt"?"pending":request.TrangThai=="Đã duyệt"?"approved":"rejected")">@request.TrangThai</span></td></tr>
    }
    @if(Model.Count==0){<tr><td colspan="4" class="catalog-empty">Chưa có yêu cầu mở khóa.</td></tr>}
    </tbody></table></div></section>
</div>
<div class="modal fade catalog-modal" id="unlockReviewModal" tabindex="-1" aria-labelledby="unlockReviewTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
    <header class="catalog-modal-header"><h2 id="unlockReviewTitle">Xét duyệt yêu cầu mở khóa</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></header>
    <form class="catalog-form" method="post" asp-action="XuLyMoKhoa" data-decision-form novalidate><input type="hidden" name="maYC" /><input type="hidden" name="action" /><div class="catalog-form-error" role="alert" hidden></div>
        <dl class="catalog-two-columns review-details"><div><dt>Người yêu cầu</dt><dd data-review="name"></dd></div><div><dt>Mã hóa đơn</dt><dd data-review="invoice"></dd></div><div><dt>Thời gian gửi</dt><dd data-review="time"></dd></div><div><dt>Số lần ghi đè</dt><dd data-review="count"></dd></div></dl>
        <label>Lý do xin mở khóa<textarea class="form-control" data-review="reason" readonly rows="3"></textarea></label>
        <label class="review-note">Lý do xét duyệt <em>*</em><textarea class="form-control" name="ghiChuDuyet" maxlength="500" required></textarea><span data-error-for="ghiChuDuyet"></span></label>
        <footer class="catalog-modal-actions review-actions"><button type="submit" class="catalog-white" value="TuChoi">Từ chối</button><button type="submit" class="catalog-primary" value="Duyet">Duyệt</button></footer>
    </form>
</div></div></div>
<partial name="_CatalogResult" />
@section Scripts {<script src="~/js/catalog.js" asp-append-version="true"></script>}
